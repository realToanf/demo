.root {
    position: absolute;
    right: 24px;
    top: 150px;
    width: 380px;
}

.card {
    background-color: rgb(255,255,255);
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0px 8px 24px rgba(0,0,0,0.14);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.title {
    font-size: 20px;
    unity-font-style: bold;
    color: rgb(17,24,39);
}

.iconBtn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: rgb(242,244,247);
    color: rgb(52,64,84);
}

.field {
    margin-top: 10px;
}

.label {
    font-size: 12px;
    color: rgb(102,112,133);
    margin-bottom: 6px;
}

.dropdown {
    height: 44px;
    border-radius: 12px;
    background-color: rgb(255,255,255);
    border-width: 1px;
    border-color: rgb(208,213,221);
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(17,24,39);
}

.cta {
    margin-top: 14px;
    height: 48px;
    border-radius: 14px;
    background-color: rgb(22, 163, 74);
    color: white;
    unity-font-style: bold;
    font-size: 16px;
}

.cta:hover {
    background-color: rgb(21, 128, 61);
}

.divider {
    height: 1px;
    background-color: rgb(234,236,240);
    margin-top: 16px;
    margin-bottom: 6px;
}

.dropdown,
.dropdown .unity-base-field__input,
.dropdown .unity-base-field__text,
.dropdown .unity-popup-field__input {
    background-color: rgb(255,255,255);
}

.dropdown .unity-base-field__input,
.dropdown .unity-popup-field__input {
    border-width: 0px;
    outline-width: 0px;
    box-shadow: none;
}