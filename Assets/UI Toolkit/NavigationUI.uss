/* ---------------------------
   Global spacing + layout
---------------------------- */

:root{
  --ui-scale: 1.25; /* 1.0 = normal, 1.25 = 125%, 1.5 = 150% */
}

.hud{
  transform: scale(var(--ui-scale));
  transform-origin: top right; /* matches your root being top-right anchored */
}

/* Card container */
.root {
    position: absolute;
    right: 24px;
    top: 24px;              /* IMPORTANT: card sits below top bar (because it's inside .content) */
    width: 380px;
}

/* Full-screen HUD root */
.hud {
    position: relative;
    width: 100%;
    height: 100%;
}

/* Content under the top bar */
.content {
    flex-grow: 1;
    padding-top: 16px;      /* breathing room under bar */
}


/* ---------------------------
   Top Bar (premium look)
---------------------------- */

.topbar {
    height: 96px;
    padding-left: 24px;
    padding-right: 24px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    background-color: rgb(255,255,255);

    border-bottom-width: 1px;
    border-bottom-color: rgb(226,232,240);
    box-shadow: 0px 10px 26px rgba(0,0,0,0.10);

    overflow: hidden; /* nothing can spill out */
}

/* Side blocks keep center perfectly centered */
.topbar__side {
    width: 180px;
    height: 100%;
    flex-shrink: 0;

    justify-content: center;
    align-items: center;

    overflow: hidden;
}

.topbar__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;

    padding-left: 10px;
    padding-right: 10px;
}

/* Stronger typography */
.topbar__title {
    font-size: 22px;
    unity-font-style: bold;
    color: rgb(15,23,42);
}

.topbar__subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: rgb(100,116,139);
}

/* Logos (responsive + never “fly out”) */
.logo {
    height: 78%;
    width: 78%;
    max-width: 100%;
    max-height: 100%;
    flex-shrink: 0;

    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.logo--left  { background-image: resource("logo_noitiet"); }
.logo--right { background-image: resource("logo_isofh"); }


/* ---------------------------
   Card (cleaner + tighter)
---------------------------- */

.card {
    background-color: rgb(255,255,255);
    border-radius: 16px;
    padding: 18px;

    box-shadow: 0px 14px 34px rgba(0,0,0,0.14);

    border-width: 1px;
    border-color: rgb(226,232,240);
}

/* Header row */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 12px;
    cursor: pointer;
}

.title {
    font-size: 20px;
    unity-font-style: bold;
    color: rgb(15,23,42);
}

/* Bigger circular icon button (PNG logo) */
.iconBtn {
    width: 44px;
    height: 44px;
    border-radius: 999px;

    justify-content: center;
    align-items: center;

    background-color: rgb(241,245,249);
    border-width: 1px;
    border-color: rgb(226,232,240);

    padding: 0px;
    cursor: pointer;

    /* icon from Resources */
    background-image: resource("search-icon");
    background-repeat: no-repeat;
    background-position: center;

    /* Bigger icon.
       - Use fixed size for PNG so it actually looks big.
       - If it ever crops weirdly, switch to "contain" instead. */
    background-size: 26px 26px;

    transition-property: background-color;
    transition-duration: 100ms;

    box-shadow: 0px 6px 14px rgba(0,0,0,0.10);
}

.iconBtn:hover { background-color: rgb(226,232,240); }
.iconBtn:active {
    background-color: rgb(203,213,225);
    box-shadow: 0px 3px 8px rgba(0,0,0,0.10);
}

/* Collapsible behavior */
.cardContent {
    overflow: hidden;
}

/* When collapsed: only hide content (header+icon remain visible) */
.card--collapsed .cardContent {
    display: none;
}

/* Helps initial collapsed state in UXML */
.cardContent--collapsed {
    display: none;
}

/* Optional: remove extra empty space under header when collapsed */
.card--collapsed .header {
    margin-bottom: 0px;
}


/* ---------------------------
   Fields + labels
---------------------------- */

.field {
    margin-top: 12px;
}

.labelRow {
    flex-direction: row;
    align-items: center;
}

.label {
    font-size: 12px;
    color: rgb(100,116,139);
    margin-bottom: 6px;
}

.labelRow .label {
    flex-grow: 1;
}

/* Dropdowns */
.dropdown {
    height: 44px;
    border-radius: 12px;

    background-color: rgb(255,255,255);
    border-width: 1px;
    border-color: rgb(203,213,225);

    padding-left: 12px;
    padding-right: 12px;

    color: rgb(15,23,42);
}

/* Make inner input clean */
.dropdown,
.dropdown .unity-base-field__input,
.dropdown .unity-base-field__text,
.dropdown .unity-popup-field__input {
    background-color: rgb(255,255,255);
}

.dropdown .unity-base-field__input,
.dropdown .unity-popup-field__input {
    border-width: 0px;
    outline-width: 0px;
    box-shadow: none;
}


/* ---------------------------
   Buttons (more polished)
---------------------------- */

.cta {
    margin-top: 14px;
    height: 48px;
    border-radius: 14px;

    background-color: rgb(22, 163, 74);
    color: white;

    unity-font-style: bold;
    font-size: 16px;

    box-shadow: 0px 10px 18px rgba(22,163,74,0.22);
}

.cta:hover {
    background-color: rgb(21, 128, 61);
}

.cta.cancel {
    background-color: rgb(220, 38, 38);
    box-shadow: 0px 10px 18px rgba(220,38,38,0.18);
}

.cta.cancel:hover {
    background-color: rgb(185, 28, 28);
}

.cta:disabled {
    opacity: 0.45;
    box-shadow: none;
}

/* Secondary action buttons */
.modeBtn, .refocus {
    margin-top: 10px;
    margin-bottom: 10px;
    height: 40px;
    border-radius: 12px;

    background-color: rgb(30, 64, 175);
    color: white;

    unity-font-style: bold;
    font-size: 14px;

    box-shadow: 0px 10px 18px rgba(30,64,175,0.18);
}

.modeBtn:hover, .refocus:hover {
    background-color: rgb(23,37,84);
}


/* ---------------------------
   Divider
---------------------------- */

.divider {
    height: 1px;
    background-color: rgb(226,232,240);
    margin-top: 16px;
    margin-bottom: 6px;
}

/* ---------------------------
   Modal
---------------------------- */

.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.65);
    z-index: 9999;
}

.modal {
    width: 560px;
    max-width: 92%;
    padding: 18px;
    border-radius: 14px;
    background-color: rgb(25, 25, 25);
}

.modal-title {
    font-size: 20px;
    unity-font-style: bold;
    margin-bottom: 10px;
    color: white;
}

.modal-body {
    white-space: normal;
    color: rgb(220, 220, 220);
    margin-bottom: 14px;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
}

/* toggle */
.hidden {
    display: none;
}

.headerActions {
    flex-direction: row;
    align-items: center;
}

/* spacing between the two icon buttons */
.headerActions .iconBtn {
    margin-left: 8px;
}

.iconBtn--help {
    background-image: resource("question-mark-sign-icon");
    background-size: 26px 26px;
}

.modal-body {
    white-space: pre-wrap;
}

/* Darken background a bit but not too aggressive */
.overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;

    justify-content: center;
    align-items: center;

    background-color: rgba(0,0,0,0.42);
    z-index: 9999;
}

/* White smooth card */
.modal {
    width: 560px;
    max-width: 92%;

    padding: 22px 24px;

    border-radius: 22px;

    background-color: rgb(255,255,255);

    /* premium shadow */
    box-shadow: 0px 20px 60px rgba(0,0,0,0.22);

    border-width: 1px;
    border-color: rgb(226,232,240);

    /* slight lift */
    translate: 0px -8px;
}

.modal-title {
    font-size: 20px;
    unity-font-style: bold;
    color: rgb(15,23,42);

    margin-bottom: 10px;
}

/* IMPORTANT: shows \n correctly */
.modal-body {
    white-space: pre-wrap;

    font-size: 14px;
    color: rgb(51,65,85);

    line-height: 1.35;

    margin-bottom: 18px;
}

/* actions row */
.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
}

/* Make the modal button look consistent with your UI */
#instructionCloseBtn {
    height: 40px;

    padding-left: 16px;
    padding-right: 16px;

    border-radius: 14px;

    background-color: rgb(30, 64, 175);
    color: white;

    unity-font-style: bold;
    font-size: 14px;

    border-width: 0px;

    box-shadow: 0px 10px 18px rgba(15,23,42,0.18);
    cursor: pointer;
}

#instructionCloseBtn:hover {
    background-color: rgb(30,41,59);
}

#instructionCloseBtn:active {
    background-color: rgb(2,6,23);
    box-shadow: 0px 6px 12px rgba(15,23,42,0.16);
}
